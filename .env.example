# Drishti Scan Environment Configuration

# Project
PROJECT_NAME="Drishti Scan"
PROJECT_VERSION="1.0.0"

# Security & Authentication
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY="replace-with-a-random-secret-key-of-32-or-more-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local zero-config SQLite
DATABASE_URL="sqlite:///./drishti_scan.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/drishtiscan"

# Threat Intelligence & AI Enrichment (Optional)
# Leave blank to use built-in local heuristic and expert synthesis engines
VIRUSTOTAL_API_KEY=""
GEMINI_API_KEY=""
